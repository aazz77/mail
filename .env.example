HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite://data/cloud-mail.db?mode=rwc
STORAGE_DIR=./data/storage
JWT_SECRET=change-this-to-a-long-random-secret
DOMAINS=["example.com"]
ADMIN=admin@example.com
CORS_ORIGINS=["http://localhost:3001"]

# ── Outbound SMTP (optional) ─────────────────────────────────────────────────
# When set, the server sends outgoing mail via this SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to 0 for plain SMTP without TLS (e.g. local relay). Default: 1.
SMTP_TLS=1

# ── Inbound SMTP listener (optional) ─────────────────────────────────────────
# Requires MX records pointing at this host. Port 25 needs root/CAP_NET_BIND_SERVICE.
SMTP_LISTEN_PORT=25
